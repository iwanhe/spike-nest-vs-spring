# Salin file ini menjadi .env, lalu sesuaikan bila perlu.
# Kata sandi di sini hanya untuk laptop pengembang. Jangan dipakai di server.
DATABASE_URL=postgres://spike:spike_dev_only@localhost:5432/spike
API_URL=http://localhost:3000
ERP_URL=http://localhost:4000
MODE_UJI=1
BATAS_PERSETUJUAN=5s
# S5: alamat ERP tiruan sudah di atas. Pekerja outbox bisa dipercepat untuk uji:
# OUTBOX_JEDA_MS=250
# OUTBOX_MUNDUR_MS=500
# S6: isi untuk menyalakan pemeriksaan token (Keycloak harus jalan lebih dulu).
# AUTH_ISSUER=http://localhost:8081/realms/spike
# LOG_JSON=1
