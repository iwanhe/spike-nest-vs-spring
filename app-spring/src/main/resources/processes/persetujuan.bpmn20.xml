<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://kcsi.id/spike">

  <!-- Diajukan, lalu menunggu keputusan. Bila batas waktu lewat, dieskalasi. -->
  <process id="persetujuanPengajuan" name="Persetujuan pengajuan" isExecutable="true">
    <startEvent id="mulai"/>
    <sequenceFlow id="f1" sourceRef="mulai" targetRef="tandaiDiajukan"/>

    <serviceTask id="tandaiDiajukan" name="Tandai diajukan"
                 flowable:expression="${persetujuanAksi.tandaiDiajukan(pengajuanId)}"/>
    <sequenceFlow id="f2" sourceRef="tandaiDiajukan" targetRef="tungguKeputusan"/>

    <userTask id="tungguKeputusan" name="Tunggu keputusan"/>
    <boundaryEvent id="batasWaktu" attachedToRef="tungguKeputusan" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>${batas}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>

    <sequenceFlow id="f3" sourceRef="tungguKeputusan" targetRef="catatKeputusan"/>
    <serviceTask id="catatKeputusan" name="Catat keputusan"
                 flowable:expression="${persetujuanAksi.catat(pengajuanId, keputusan, penyetuju)}"/>
    <sequenceFlow id="f4" sourceRef="catatKeputusan" targetRef="selesai"/>

    <sequenceFlow id="f5" sourceRef="batasWaktu" targetRef="eskalasi"/>
    <serviceTask id="eskalasi" name="Eskalasi"
                 flowable:expression="${persetujuanAksi.eskalasi(pengajuanId)}"/>
    <sequenceFlow id="f6" sourceRef="eskalasi" targetRef="selesai"/>

    <endEvent id="selesai"/>
  </process>
</definitions>
